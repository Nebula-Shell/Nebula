<Application x:Class="CaelestiaWin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CaelestiaWin.UI.Converters;assembly=CaelestiaWin.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CaelestiaWin.UI;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="/CaelestiaWin.UI;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="/CaelestiaWin.UI;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StringHasTextToVisibilityConverter x:Key="StringHasTextToVisibilityConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
