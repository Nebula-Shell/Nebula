<Window x:Class="CaelestiaWin.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CaelestiaWin.Terminal"
        Title="Nebula Terminal"
        Width="980"
        Height="620"
        MinWidth="280"
        MinHeight="170"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="JetBrainsMono Nerd Font, JetBrains Mono, Cascadia Mono, Consolas">
    <Border x:Name="ShellBorder"
            Margin="1"
            Background="{DynamicResource NebulaPanelBrush}"
            BorderBrush="{DynamicResource NebulaHairlineBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{DynamicResource NebulaShadow}"
            MouseLeftButtonDown="ShellSurface_OnMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="OutputScrollViewer"
                          Grid.Row="0"
                          Margin="10,10,10,4"
                          VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="{Binding ActualHeight, ElementName=OutputScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Lines}"
                                  VerticalAlignment="Bottom">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:TerminalLineTextBlock Line="{Binding}"
                                                             Foreground="{DynamicResource NebulaTextBrush}"
                                                             FontSize="13"
                                                             LineHeight="20"
                                                             TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Margin="10,4,10,10"
                    Padding="10,8,10,8"
                    Background="{DynamicResource NebulaPanelAltBrush}"
                    BorderBrush="{DynamicResource NebulaHairlineBrush}"
                    BorderThickness="0"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding UserName}"
                                   Foreground="{DynamicResource NebulaTextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />

                        <TextBlock Grid.Column="1"
                                   Text="❯"
                                   Foreground="{DynamicResource NebulaAccentBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <Grid Grid.Column="2">
                            <TextBlock IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontSize="14">
                                <TextBlock.Inlines><Run Text="{Binding InlineSuggestionPrefix, Mode=OneWay}" Foreground="Transparent" /><Run Text="{Binding InlineSuggestionSuffix, Mode=OneWay}" Foreground="{DynamicResource NebulaMutedBrush}" /></TextBlock.Inlines>
                            </TextBlock>

                            <TextBox x:Name="CommandBox"
                                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TerminalCommandTextBoxStyle}"
                                     FontSize="14"
                                     KeyDown="CommandBox_OnKeyDown"
                                     PreviewKeyDown="CommandBox_OnPreviewKeyDown" />
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               Text="{Binding CurrentDirectory}"
                               Foreground="{DynamicResource NebulaMutedBrush}"
                               Opacity="0.56"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
