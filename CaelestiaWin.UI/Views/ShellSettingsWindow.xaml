<Window x:Class="CaelestiaWin.UI.Views.ShellSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Settings"
        Width="1040"
        Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SettingsSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style x:Key="SettingsRoundIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        </Style>

        <Style x:Key="SettingsSectionStyle" TargetType="Border" BasedOn="{StaticResource CardPanelStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>

        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#0F000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ShellHeadingFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
        </Style>

        <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ShellHeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingsOptionRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SystemInfoCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsGroupStyle}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style x:Key="WallpaperOptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="122" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="180" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WallpaperCard"
                                Padding="8"
                                CornerRadius="14"
                                Background="#0CFFFFFF"
                                BorderBrush="{DynamicResource ShellHairlineBrush}"
                                BorderThickness="1">
                            <Grid>
                                <StackPanel>
                                    <Border Height="68"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Path}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource ShellForegroundBrush}"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource ShellMutedBrush}"
                                               FontSize="11"
                                               Text="{Binding Subtitle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border x:Name="HoverIndicator"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="14"
                                        Background="#A0181D26"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        Opacity="0">
                                    <TextBlock Text="&#xE8A1;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>

                                <Border x:Name="CurrentIndicator"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="14"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ShellBackgroundBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WallpaperCard" Property="Background" Value="#12FFFFFF" />
                                <Setter TargetName="WallpaperCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="HoverIndicator" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WallpaperCard" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="WallpaperCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="WallpaperCard" Property="Background" Value="#13223C" />
                                <Setter TargetName="CurrentIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Background="#F0181D26"
                             BorderBrush="{DynamicResource ShellHairlineBrush}"
                             BorderThickness="1"
                             Padding="10">
                        <StackPanel Width="240">
                            <Border Height="136"
                                    CornerRadius="12"
                                    ClipToBounds="True">
                                <Image Source="{Binding Path}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding Title}"
                                       Foreground="{DynamicResource ShellForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Click to apply"
                                       Foreground="{DynamicResource ShellMutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Style="{StaticResource GlassPanelStyle}"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18"
                    Background="#15101822"
                    BorderBrush="{DynamicResource ShellHairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,4,0,18">
                        <TextBlock Text="Nebula"
                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                   FontSize="28"
                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Settings"
                                   FontSize="16"
                                   Foreground="{DynamicResource ShellMutedBrush}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,18"
                            Padding="12,9"
                            CornerRadius="14"
                            Background="#16000000"
                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ShellMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Text="Search settings"
                                       Foreground="{DynamicResource ShellMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="AppearanceSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Appearance" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="ControlCenterSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Control Center" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="SoundSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE995;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Sound" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="LauncherSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Launcher" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="DefaultsSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Defaults" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="WindowingSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Windowing" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="GameCenterSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Game Center" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="StartupSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Startup" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="ShortcutsSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Keyboard" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="NotificationsSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Notifications" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="WifiSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Wi-Fi" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}"
                                    Click="NavigateButton_OnClick"
                                    Tag="SystemInfoSection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="System Info" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SettingsTitle"
                                   Text="Appearance"
                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                   FontSize="30"
                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="38"
                            Height="38"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding CloseCommand}"
                            Content="&#xE711;" />
                </Grid>

                <ScrollViewer x:Name="SettingsScrollViewer"
                              Grid.Row="1"
                              Margin="0,22,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="AppearanceSection" Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <Border Padding="22,20,22,8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Appearance" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsGroupStyle}" Margin="22,10,22,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsGroupTitleStyle}" Text="Accent palette" />
                                        <ListBox ItemsSource="{Binding AccentPaletteOptions}"
                                                 SelectedItem="{Binding SelectedAccentPaletteOption}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Margin="0,12,0,0">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,0,12,12" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="PaletteCard"
                                                                        Width="104"
                                                                        Padding="12"
                                                                        CornerRadius="16"
                                                                        BorderThickness="1"
                                                                        Background="#0CFFFFFF"
                                                                        BorderBrush="{DynamicResource ShellHairlineBrush}">
                                                                    <StackPanel>
                                                                        <Border Height="30" CornerRadius="10">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="{Binding AccentColor}" Offset="0" />
                                                                                    <GradientStop Color="{Binding SecondaryAccentColor}" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <TextBlock Margin="0,10,0,0"
                                                                                   Text="{Binding Name}"
                                                                                   HorizontalAlignment="Center"
                                                                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="PaletteCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter TargetName="PaletteCard" Property="Background" Value="#142034" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="PaletteCard" Property="Background" Value="#12FFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="Keep shell and Windows accent separate"
                                                      IsChecked="{Binding KeepWindowsAccentSeparate}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18"
                                                        Height="18"
                                                        Margin="0,0,8,0"
                                                        CornerRadius="9"
                                                        BorderBrush="{DynamicResource ShellHairlineBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding WindowsAccentColor}" />
                                                <Button Style="{StaticResource ShellButtonStyle}"
                                                        Padding="14,8"
                                                        Command="{Binding UseWindowsAccentCommand}"
                                                        Content="Use Windows accent" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0"
                                                   Style="{StaticResource SettingsHintStyle}"
                                                   Text="{Binding WindowsAccentSummary}" />
                                        <CheckBox Margin="0,12,0,0"
                                                  Content="Tint shell panels and backgrounds with accent"
                                                  IsChecked="{Binding TintShellSurfacesWithAccent}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsGroupStyle}" Margin="22,0,22,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingsGroupTitleStyle}" Text="Colors" />
                                        <UniformGrid Columns="2" Margin="0,14,0,0">
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Accent color" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource ShellTextBoxStyle}" Text="{Binding SelectedAccentColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentSwatchButtonStyle}" Background="{Binding SelectedAccentColor}" Command="{Binding PickColorCommand}" CommandParameter="SelectedAccentColor" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Control highlight" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource ShellTextBoxStyle}" Text="{Binding SecondaryAccentColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentSwatchButtonStyle}" Background="{Binding SecondaryAccentColor}" Command="{Binding PickColorCommand}" CommandParameter="SecondaryAccentColor" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,12">
                                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Foreground text" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource ShellTextBoxStyle}" Text="{Binding ForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentSwatchButtonStyle}" Background="{Binding ForegroundColor}" Command="{Binding PickColorCommand}" CommandParameter="ForegroundColor" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Muted text" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource ShellTextBoxStyle}" Text="{Binding MutedForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentSwatchButtonStyle}" Background="{Binding MutedForegroundColor}" Command="{Binding PickColorCommand}" CommandParameter="MutedForegroundColor" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Panel base" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource ShellTextBoxStyle}" Text="{Binding PanelColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentSwatchButtonStyle}" Background="{Binding PanelColor}" Command="{Binding PickColorCommand}" CommandParameter="PanelColor" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Background base" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource ShellTextBoxStyle}" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentSwatchButtonStyle}" Background="{Binding BackgroundColor}" Command="{Binding PickColorCommand}" CommandParameter="BackgroundColor" />
                                                </Grid>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="22,0,22,14">
                                    <Border Style="{StaticResource SettingsGroupStyle}" Margin="0,0,7,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingsGroupTitleStyle}" Text="Wallpaper" />
                                            <TextBlock Margin="0,8,0,12"
                                                       Style="{StaticResource SettingsHintStyle}"
                                                       Text="{Binding WallpaperSummary}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ShellButtonStyle}" Margin="0,0,10,0" Command="{Binding SelectWallpaperCommand}" Content="Choose" />
