                </Button>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExplorerWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button Width="194" Margin="0,0,0,16"
                        Style="{StaticResource ControlCenterActionButtonStyle}"
                        Command="{Binding ReturnToExplorerCommand}"
                        Background="#16FFFFFF"
                        HorizontalContentAlignment="Stretch">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#1A000000"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource ShellForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Explorer"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="16"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="Return"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="Backdrop"
          Margin="0,78,0,0"
          Background="Transparent"
          MouseLeftButtonDown="Backdrop_OnMouseLeftButtonDown">
        <Border x:Name="BackdropDimming"
                Background="#48101822"
                IsHitTestVisible="False"
                Opacity="0" />

        <Border x:Name="Panel"
                Width="440"
                HorizontalAlignment="Right"
                Margin="0,0,20,16"
                Padding="20"
                Opacity="0"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Style="{StaticResource GlassPanelStyle}"
                RenderTransformOrigin="1,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTranslate" X="36" />
            </Border.RenderTransform>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Control Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ClockText}"
                                       Margin="0,8,0,0"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="36"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="{Binding DateSummary}"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Width="38"
                                    Height="38"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ToggleEditModeCommand}"
                                    Content="&#xE70F;"
                                    ToolTip="Edit layout" />
                            <Button Width="38"
                                    Height="38"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}"
                                    Content="&#xE713;" />
                            <Button Width="38"
                                    Height="38"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CloseCommand}"
                                    Content="&#xE711;" />
                        </StackPanel>
                    </Grid>

                    <Border Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#1AFFFFFF" CornerRadius="12" Padding="12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource ShellMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Drag widgets to rearrange them" Foreground="{DynamicResource ShellForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ActiveWidgets}"
                                  PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown"
                                  MouseMove="Widget_MouseMove"
                                  AllowDrop="True"
                                  DragOver="Widget_DragOver"
                                  Drop="Widget_Drop">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Width="400" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.GameMode}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource GameModeWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Connectivity}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ConnectivityWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Power}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource PowerWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Media}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource MediaWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Display}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource DisplayWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Sound}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource SoundWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Actions}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ActionButtonsWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Pomodoro}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource PomodoroWidgetTemplate}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:ControlCenterWidgetKind.Explorer}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ExplorerWidgetTemplate}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hidden widgets restore panel (edit mode only) -->
                    <ItemsControl ItemsSource="{Binding HiddenWidgets}"
                                  Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Width="400" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="194" Margin="0,0,6,8"
                                        Style="{StaticResource ControlCenterActionButtonStyle}"
                                        Background="#0CFFFFFF"
                                        Opacity="0.5"
                                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Margin="14,10" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource ShellForegroundBrush}"
                                                   FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

<Grid Width="440"
              Margin="0,0,20,16"
              HorizontalAlignment="Right"
              IsHitTestVisible="{Binding IsSoundMenuOpen}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSoundMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#00000000" />

            <Border Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource GlassPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Output"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="24"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="{Binding SoundStatusText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="38"
                                Height="38"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseSoundMenuCommand}"
                                Content="&#xE72B;" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Global volume"
                               Margin="0,8,0,0"
