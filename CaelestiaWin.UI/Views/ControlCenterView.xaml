<UserControl x:Class="CaelestiaWin.UI.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:views="clr-namespace:CaelestiaWin.UI.Views"
             xmlns:enums="clr-namespace:CaelestiaWin.Core.Enums;assembly=CaelestiaWin.Core"
             Visibility="Collapsed">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ControlCenterCardStyle" TargetType="Border" BasedOn="{StaticResource CardPanelStyle}">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Background" Value="#1BFFFFFF" />
        </Style>

        <Style x:Key="ControlCenterTileButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.95" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlCenterActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlCenterTileButtonStyle}">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>

        <Style x:Key="ControlCenterFittingTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="13" />
        </Style>

        <DataTemplate x:Key="GameModeWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Width="400" Margin="0,0,0,16"
                            Style="{StaticResource ControlCenterCardStyle}"
                            Background="#1D183122"
                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="24"
                                    Background="#2A8B5CF6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Game Mode"
                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                           FontSize="18"
                                           Foreground="{DynamicResource ShellForegroundBrush}" />
                                <TextBlock Text="{Binding GameModeSummary}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource ShellMutedBrush}" />
                                <TextBlock Text="{Binding GameModeDetail}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Width="36"
                                        Height="36"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenGameCenterCommand}"
                                        Content="&#xE713;" />
                                <ToggleButton Width="58"
                                              Height="34"
                                              Style="{StaticResource ShellSwitchStyle}"
                                              IsChecked="{Binding IsGameModeAutoEnabled, Mode=OneWay}"
                                              Command="{Binding ToggleGameModeCommand}"
                                              VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConnectivityWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Width="220" Margin="0,0,12,16"
                                Style="{StaticResource ControlCenterCardStyle}"
                                Background="#20577896"
                                BorderBrush="#468FD9F0">
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Width="48"
                                            Height="48"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="#FF1B75F2"
                                            Command="{Binding OpenWifiMenuCommand}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip="Open Wi-Fi networks">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="24">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#xE701;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            Command="{Binding OpenWifiMenuCommand}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Wi-Fi"
                                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                                            <TextBlock Text="{Binding WifiSummary}"
                                                       Margin="0,3,0,0"
                                                       Foreground="#DCE8EF" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowBluetoothRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Width="58"
                                                  Height="34"
                                                  Style="{StaticResource ShellSwitchStyle}"
                                                  IsChecked="{Binding SystemStatus.BluetoothEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleBluetoothCommand}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Toggle Bluetooth" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Bluetooth"
                                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                                        <TextBlock Text="{Binding BluetoothSummary}"
                                                   Margin="0,3,0,0"
                                                   Foreground="#DCE8EF" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowInputInConnectivityCard}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Width="44"
                                            Height="44"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="#FF1B75F2"
                                            Command="{Binding OpenInputMenuCommand}"
                                            VerticalAlignment="Center"
                                            ToolTip="Open input devices">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="22">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#xE720;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>

                                    <Button Grid.Column="1"
                                            Margin="14,0,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            Command="{Binding OpenInputMenuCommand}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Input"
                                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                                            <TextBlock Text="Microphone routing"
                                                       Margin="0,3,0,0"
                                                       Foreground="#DCE8EF" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PowerWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid Width="168" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Style="{StaticResource ControlCenterActionButtonStyle}"
                                    Command="{Binding LockCommand}"
                                    Background="#20FFFFFF">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="21"
                                            Background="#1A000000">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Lock"
                                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                                   FontSize="17"
                                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                                        <Viewbox Margin="0,3,0,0"
                                                 MaxHeight="28"
                                                 Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 HorizontalAlignment="Left">
                                            <TextBlock Text="Secure session"
                                                       Width="92"
                                                       Style="{StaticResource ControlCenterFittingTextStyle}"
                                                       Foreground="{DynamicResource ShellMutedBrush}" />
                                        </Viewbox>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource ControlCenterActionButtonStyle}"
                                        Command="{Binding OpenPowerMenuCommand}"
                                        Background="#18FFFFFF">
                                    <StackPanel Margin="14,14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Power Off"
                                                   Margin="0,8,0,0"
                                                   TextAlignment="Center"
                                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                                   FontSize="15" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource ControlCenterActionButtonStyle}"
                                        Command="{Binding SignOutCommand}"
                                        Background="#18FFFFFF">
                                    <StackPanel Margin="14,14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8AC;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center" />
                                        <Viewbox Margin="0,8,0,0"
                                                 MaxHeight="34"
                                                 Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 HorizontalAlignment="Center">
                                            <TextBlock Text="Sign out"
                                                       Width="62"
                                                       TextAlignment="Center"
                                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                                       FontSize="15"
                                                       Style="{StaticResource ControlCenterFittingTextStyle}" />
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MediaWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:MediaWidgetView Width="400" Margin="0,0,0,16" />
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DisplayWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Width="400" Margin="0,0,0,16"
                            Style="{StaticResource ControlCenterCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding BrightnessSummary}"
                                           Foreground="{DynamicResource ShellMutedBrush}" />
                                <Slider Style="{StaticResource ShellSliderStyle}"
                                        Margin="0,16,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding BrightnessLevel}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="42"
                                    Height="42"
                                    Margin="14,0,0,0"
                                    CornerRadius="21"
                                    Background="#16000000"
                                    BorderBrush="{DynamicResource ShellHairlineBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Bottom">
                                <TextBlock Text="&#xE706;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource ShellForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SoundWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Width="400" Margin="0,0,0,16" Style="{StaticResource ControlCenterCardStyle}"
                            MouseLeftButtonUp="SoundCard_OnMouseLeftButtonUp"
                            Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding VolumeSummary}"
                                           Foreground="{DynamicResource ShellMutedBrush}" />
                                <Slider Style="{StaticResource ShellSliderStyle}"
                                        Margin="0,16,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Cursor="Arrow"
                                        Value="{Binding VolumeLevel}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="42"
                                    Height="42"
                                    Margin="14,0,0,0"
                                    CornerRadius="21"
                                    Background="#16000000"
                                    BorderBrush="{DynamicResource ShellHairlineBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Bottom">
                                <TextBlock Text="&#xE767;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource ShellForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionButtonsWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button Width="400" Margin="0,0,0,16"
                        Command="{Binding OpenInputMenuCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ControlCenterActionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Background" Value="#16FFFFFF" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowInputInBottomRow}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#1A000000"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE720;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource ShellForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Input"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="16"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="Devices"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
                
        <Border Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" CornerRadius="24" Cursor="SizeAll">
            <Grid>
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Command="{Binding DataContext.ToggleWidgetVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=Content}"
                        ToolTip="Hide widget"
                        Style="{StaticResource IconButtonStyle}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PomodoroWidgetTemplate">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button Width="194" Margin="0,0,12,16"
                        Style="{StaticResource ControlCenterActionButtonStyle}"
                        Command="{Binding OpenPomodoroMenuCommand}"
                        Background="#16FFFFFF"
                        HorizontalContentAlignment="Stretch">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#1A000000"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE823;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource ShellForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center">
