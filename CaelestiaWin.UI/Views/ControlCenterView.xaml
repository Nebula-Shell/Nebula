                               FontSize="15"
                               Foreground="{DynamicResource ShellForegroundBrush}" />
                    <Slider Grid.Row="2"
                            Style="{StaticResource ShellSliderStyle}"
                            Margin="0,12,0,18"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding VolumeLevel}" />

                    <TextBlock Grid.Row="3"
                               Text="Output device"
                               FontFamily="{DynamicResource ShellHeadingFont}"
                               FontSize="15"
                               Foreground="{DynamicResource ShellForegroundBrush}" />
                    <ItemsControl Grid.Row="4"
                                  Margin="0,10,0,0"
                                  ItemsSource="{Binding OutputDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        MinHeight="60"
                                        Padding="14,9"
                                        Style="{StaticResource ControlCenterActionButtonStyle}"
                                        Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="5"
                               Text="App volume"
                               Margin="0,12,0,0"
                               FontFamily="{DynamicResource ShellHeadingFont}"
                               FontSize="15"
                               Foreground="{DynamicResource ShellForegroundBrush}" />
                    <ScrollViewer Grid.Row="6"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AppVolumeSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Background="#10000000"
                                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="26"
                                                        Height="26"
                                                        CornerRadius="13"
                                                        Background="#12000000"
                                                        BorderBrush="{DynamicResource ShellHairlineBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Width="16"
                                                               Height="16"
                                                               Source="{Binding IconPath}"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{Binding IconPath, Converter={StaticResource StringHasTextToVisibilityConverter}}" />
                                                        <TextBlock Text="&#xE7F8;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ShellMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource StringHasTextToVisibilityConverter}, ConverterParameter=Invert}" />
                                                    </Grid>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DisplayName}"
                                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource ShellForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Slider Style="{StaticResource ShellSliderStyle}"
                                                    Margin="0,8,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Width="440"
              Margin="0,0,20,16"
              HorizontalAlignment="Right"
              IsHitTestVisible="{Binding IsInputMenuOpen}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInputMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#00000000" />

            <Border Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource GlassPanelStyle}">
