                                Width="38"
                                Height="38"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ClosePomodoroMenuCommand}"
                                Content="&#xE72B;" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,0,0,16"
                            Style="{StaticResource ControlCenterCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding PomodoroPhaseLabel, StringFormat={}{0} session}"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="15"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Width="36"
                                        Height="36"
                                        Command="{Binding DecreasePomodoroLengthCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="16"
                                    Content="−" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PomodoroSessionLengthMinutes, StringFormat={}{0} minutes}"
                                               HorizontalAlignment="Center"
                                               FontFamily="{DynamicResource ShellHeadingFont}"
                                               FontSize="22"
                                               Foreground="{DynamicResource ShellForegroundBrush}" />
                                    <TextBlock Text="{Binding PomodoroRemainingText}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ShellMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Command="{Binding IncreasePomodoroLengthCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="16"
                                    Content="+" />
                            </Grid>

                            <TextBlock Text="Break length"
                                       Margin="0,18,0,0"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Padding="14,8"
                                        Width="36"
                                        Height="36"
                                        Command="{Binding DecreasePomodoroBreakLengthCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="16"
                                    Content="−" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PomodoroBreakLengthMinutes, StringFormat={}{0} minutes}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                           FontSize="18"
                                           Foreground="{DynamicResource ShellForegroundBrush}" />
                                <Button Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Command="{Binding IncreasePomodoroBreakLengthCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="16"
                                    Content="+" />
                            </Grid>

                            <CheckBox Margin="0,18,0,0"
                                      Content="Automatically start the next focus or break session"
                                      IsChecked="{Binding PomodoroAutoCycleEnabled, Mode=TwoWay}"
                                      Foreground="{DynamicResource ShellMutedBrush}" />

                            <StackPanel Margin="0,18,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding ShowPomodoroStartActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Padding="14,8"
                                        Margin="0,0,8,0"
                                        Command="{Binding StartPomodoroCommand}"
                                        Style="{StaticResource ShellButtonStyle}"
                                        Content="Start focus" />
                                <Button Padding="14,8"
                                        Command="{Binding StartPomodoroBreakCommand}"
                                        Style="{StaticResource ShellButtonStyle}"
                                        Content="Start break" />
                            </StackPanel>

                            <StackPanel Margin="0,18,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding ShowPomodoroActiveActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Padding="14,8"
                                        Margin="0,0,8,0"
                                        Command="{Binding TogglePomodoroPauseCommand}"
                                        Style="{StaticResource ShellButtonStyle}"
                                        Content="{Binding PomodoroPrimaryActionLabel}" />
                                <Button Padding="14,8"
                                        Margin="0,0,8,0"
                                        Command="{Binding RestartPomodoroCommand}"
                                        Style="{StaticResource ShellButtonStyle}"
                                        Content="Restart" />
                                <Button Padding="14,8"
                                        Command="{Binding StopPomodoroCommand}"
                                        Style="{StaticResource ShellButtonStyle}"
                                        Content="Stop" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding PomodoroSummaryText}"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="16"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="{Binding PomodoroTotalFocusText}"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Padding="12,7"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ShellButtonStyle}"
                                    Background="{Binding PomodoroHistoryRangeWeekBackground}"
                                    Command="{Binding ShowWeeklyPomodoroHistoryCommand}"
                                    Content="Week" />
                            <Button Padding="12,7"
                                    Style="{StaticResource ShellButtonStyle}"
                                    Background="{Binding PomodoroHistoryRangeMonthBackground}"
                                    Command="{Binding ShowMonthlyPomodoroHistoryCommand}"
                                    Content="Month" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3"
                            Style="{StaticResource ControlCenterCardStyle}">
                        <Grid Margin="0,8,0,0">
                            <Grid Visibility="{Binding IsPomodoroWeekView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding PomodoroFocusBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0"
                                                        VerticalAlignment="Bottom">
                                                <Border Width="{Binding Width}"
                                                        Background="Transparent"
                                                        VerticalAlignment="Bottom">
                                                    <Border.ToolTip>
                                                        <ToolTip Content="{Binding ToolTip}" />
                                                    </Border.ToolTip>
                                                    <Border Height="{Binding Height}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="8"
                                                            Background="{Binding FillBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0.88" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Setter Property="BorderBrush" Value="#88FFFFFF" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="{Binding Label}"
                                                           Margin="0,8,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ShellMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Visibility="{Binding IsPomodoroMonthView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,2,10,0"
                                            VerticalAlignment="Top">
                                    <TextBlock Text="Sun" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}" />
                                    <TextBlock Text="Tue" Margin="0,18,0,0" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}" />
                                    <TextBlock Text="Thu" Margin="0,18,0,0" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}" />
                                    <TextBlock Text="Sat" Margin="0,18,0,0" FontSize="10" Foreground="{DynamicResource ShellMutedBrush}" />
                                </StackPanel>
                                <ScrollViewer Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False">
                                    <ItemsControl ItemsSource="{Binding PomodoroHeatmapCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical"
                                                       Height="140" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="16"
                                                    Height="16"
                                                    Margin="2"
                                                    CornerRadius="4"
                                                    Background="{Binding FillBrush}">
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding ToolTip}" />
                                                </Border.ToolTip>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#AAFFFFFF" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Margin="0,12,0,0"
                            Style="{StaticResource ControlCenterCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding PomodoroStatusLabel}"
                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                           FontSize="15"
                                           Foreground="{DynamicResource ShellForegroundBrush}" />
                                <TextBlock Text="{Binding PomodoroElapsedText, StringFormat=Elapsed {0}}"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource ShellMutedBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PomodoroRemainingText}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Width="440"
              Margin="0,0,20,16"
              HorizontalAlignment="Right"
              IsHitTestVisible="{Binding IsWifiMenuOpen}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWifiMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#00000000" />

            <Border Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource GlassPanelStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Wi-Fi Networks"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="24"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="{Binding WifiStatusText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="38"
                                Height="38"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseWifiMenuCommand}"
                                Content="&#xE72B;" />
                    </Grid>

                    <ScrollViewer MaxHeight="330"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AvailableWifiNetworks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,8"
                                            MinHeight="44"
                                            Padding="10,7"
                                            Style="{StaticResource ControlCenterActionButtonStyle}"
                                            Command="{Binding DataContext.ConnectToWifiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="32"
                                                    Height="32"
                                                    CornerRadius="16"
                                                    Background="#1A000000"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="&#xE701;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource ShellForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Ssid}"
                                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                                           FontSize="15"
                                                           LineHeight="17"
                                                           Foreground="{DynamicResource ShellForegroundBrush}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,0">
                                                    <TextBlock FontSize="12"
                                                               LineHeight="14"
                                                               Foreground="{DynamicResource ShellMutedBrush}">
                                                        <Run Text="{Binding SignalQuality}" />
                                                        <Run Text="% signal" />
                                                        <Run Text="  •  " />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12"
                                                               LineHeight="14"
                                                               Foreground="{DynamicResource ShellMutedBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Open" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSecure}" Value="True">
                                                                        <Setter Property="Text" Value="Secure" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="&#xE73E;">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE8D7;" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSavedProfile}" Value="True">
                                                                <Setter Property="Text" Value="Saved" />
                                                                <Setter Property="FontFamily" Value="{DynamicResource ShellBodyFont}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSecure}" Value="False" />
                                                                    <Condition Binding="{Binding IsConnected}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="Open" />
                                                                <Setter Property="FontFamily" Value="{DynamicResource ShellBodyFont}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Margin="0,14,0,0"
                            Padding="16"
                            Background="#10000000"
                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="Password Required"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       FontSize="15"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource ShellMutedBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="Selected network: " />
                                <Run Text="{Binding SelectedWifiNetwork.Ssid}" />
                            </TextBlock>
                            <TextBox Margin="0,12,0,0"
                                     Style="{StaticResource ShellTextBoxStyle}"
                                     Height="48"
                                     Padding="14,7"
                                     FontSize="16"
                                     Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Margin="0,12,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource ShellButtonStyle}"
                                        Margin="0,0,10,0"
                                        Command="{Binding CancelWifiPasswordCommand}"
                                        Content="Cancel" />
                                <Button Style="{StaticResource ShellButtonStyle}"
                                        Command="{Binding SubmitWifiPasswordCommand}"
                                        Content="Connect" />
                            </StackPanel>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWifiPasswordPromptVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Button Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            Command="{Binding OpenWifiSettingsAppCommand}"
                            Content="Open full Wi-Fi settings" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid IsHitTestVisible="{Binding IsPowerMenuOpen}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPowerMenuOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#72101822" />

            <Border Width="360"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource GlassPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Power Options"
                               FontFamily="{DynamicResource ShellHeadingFont}"
                               FontSize="24"
                               Foreground="{DynamicResource ShellForegroundBrush}" />
                    <TextBlock Text="Choose how you want Nebula to hand control back to the system."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ShellMutedBrush}" />

                    <UniformGrid Columns="3" Margin="0,18,0,0">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ControlCenterActionButtonStyle}"
                                Padding="18,22"
                                Command="{Binding ShutdownCommand}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Shutdown"
                                           Margin="0,10,0,0"
                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                           FontSize="15"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Margin="4,0"
                                Style="{StaticResource ControlCenterActionButtonStyle}"
                                Padding="18,22"
                                Command="{Binding RestartCommand}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE777;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Restart"
                                           Margin="0,10,0,0"
                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                           FontSize="15"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Margin="8,0,0,0"
                                Style="{StaticResource ControlCenterActionButtonStyle}"
                                Padding="18,22"
                                Command="{Binding RebootToFirmwareCommand}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="BIOS / UEFI"
                                           Margin="0,10,0,0"
                                           FontFamily="{DynamicResource ShellHeadingFont}"
                                           FontSize="15"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Button Margin="0,14,0,0"
                            Style="{StaticResource ShellButtonStyle}"
                            Command="{Binding ClosePowerMenuCommand}"
                            Content="Cancel" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
