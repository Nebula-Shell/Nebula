                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellMutedBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="38"
                                Height="38"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseInputMenuCommand}"
                                Content="&#xE72B;" />
                    </Grid>

                    <Border Margin="0,4,0,16"
                            Padding="16"
                            Background="#10000000"
                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
