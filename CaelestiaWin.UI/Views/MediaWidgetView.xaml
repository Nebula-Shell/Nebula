<UserControl x:Class="CaelestiaWin.UI.Views.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="24"
            Padding="18"
            Background="#1AFFFFFF">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardPanelStyle}">
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Background" Value="#1AFFFFFF" />
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="56"
                    Height="56"
                    CornerRadius="16"
                    Background="#26000000"
                    BorderBrush="{DynamicResource ShellHairlineBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    VerticalAlignment="Center">
                <Grid>
                    <Image Source="{Binding MediaSession.ArtworkPath}"
                           Stretch="UniformToFill"
                           Visibility="{Binding MediaSession.ArtworkPath, Converter={StaticResource StringHasTextToVisibilityConverter}}" />
                    <TextBlock Text="&#xE189;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource ShellForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding MediaSession.ArtworkPath, Converter={StaticResource StringHasTextToVisibilityConverter}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding MediaSession.TrackTitle}"
                           FontFamily="{DynamicResource ShellHeadingFont}"
                           FontSize="15"
                           Foreground="{DynamicResource ShellForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MediaSession.Artist}"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource ShellMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MediaSession.SourceApp}"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="#88FFFFFF"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="34"
                        Height="34"
                        Margin="0,0,8,0"
                        Command="{Binding PreviousTrackCommand}"
                        Content="&#xE892;" />
                <Button Width="38"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding PlayPauseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Content" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MediaSession.IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="&#xE769;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="34"
                        Height="34"
                        Command="{Binding NextTrackCommand}"
                        Content="&#xE893;" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
