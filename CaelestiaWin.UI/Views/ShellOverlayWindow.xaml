<Window x:Class="CaelestiaWin.UI.Views.ShellOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CaelestiaWin.UI.Views"
        Title="Nebula Shell Overlay"
        Width="1600"
        Height="900"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Grid IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDesktopDecorationsOverlay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Ellipse Width="980"
                     Height="980"
                     Fill="{DynamicResource AccentSoftBrush}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-300,-260,0" />
            <Ellipse Width="720"
                     Height="720"
                     Fill="#143D648F"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-180,0,0,-240" />
        </Grid>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="24,88,24,0"
                Padding="20"
                MaxWidth="1120"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource GlassPanelStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShortcutGuideVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Nebula Shortcuts"
                           FontFamily="{DynamicResource ShellHeadingFont}"
                           FontSize="22"
                           Foreground="{DynamicResource ShellForegroundBrush}" />
                <TextBlock Margin="0,6,0,18"
                           Text="Hold Win to keep this guide visible."
                           Foreground="{DynamicResource ShellMutedBrush}" />

                <ItemsControl ItemsSource="{Binding ShortcutGuideItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="332" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,14,14"
                                    Padding="14"
                                    Style="{StaticResource CardPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Description}"
                                                   Foreground="{DynamicResource ShellMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="14,0,0,0"
                                            Padding="10,6"
                                            Background="#16000000"
                                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Gesture}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontFamily="{DynamicResource ShellHeadingFont}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <views:TopBarView DataContext="{Binding TopBar}"
                          Margin="22,14,22,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">
            <views:TopBarView.Style>
                <Style TargetType="views:TopBarView">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.UseLeftBarLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:TopBarView.Style>
        </views:TopBarView>

        <views:LeftBarView DataContext="{Binding TopBar}"
                           Margin="14,14,0,14"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch">
            <views:LeftBarView.Style>
                <Style TargetType="views:LeftBarView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.UseLeftBarLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LeftBarView.Style>
        </views:LeftBarView>

        <views:LauncherOverlayView DataContext="{Binding Launcher}" />

        <views:OverviewView DataContext="{Binding Overview}" />

        <views:ControlCenterView DataContext="{Binding ControlCenter}" />

        <views:NotificationCenterView DataContext="{Binding NotificationCenter}" />

        <views:ClipboardHistoryView DataContext="{Binding ClipboardHistory}" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,82,0,0"
                Width="310"
                Padding="16,14"
                CornerRadius="24"
                Background="#EF131B24"
                BorderBrush="{DynamicResource AccentSoftBrush}"
                BorderThickness="1"
                Effect="{DynamicResource ShellShadow}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVolumeHudVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         From="0.97"
                                                         To="1"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         From="0.97"
                                                         To="1"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         From="-10"
                                                         To="0"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding VolumeHudGlyph}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0"
                            VerticalAlignment="Center">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Volume"
                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                        <TextBlock Text="{Binding VolumeHudSummary}"
                                   HorizontalAlignment="Right"
                                   FontSize="13"
                                   Foreground="{DynamicResource ShellMutedBrush}" />
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="7"
                                 Value="{Binding VolumeHudLevel, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Background" Value="#22FFFFFF" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid x:Name="TemplateRoot">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                                <Border x:Name="PART_Track"
                                                        Background="Transparent"
                                                        CornerRadius="4" />
                                                <Decorator x:Name="PART_Indicator"
                                                           HorizontalAlignment="Left">
                                                    <Border Background="{TemplateBinding Foreground}"
                                                            CornerRadius="4" />
                                                </Decorator>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Grid>
        </Border>

        <Border DataContext="{Binding ShellToast}"
                HorizontalAlignment="{Binding ToastHorizontalAlignment}"
                VerticalAlignment="{Binding ToastVerticalAlignment}"
                Width="380"
                Margin="{Binding ToastMargin}"
                Padding="16"
                CornerRadius="22"
                Background="#EE131B24"
                BorderBrush="{DynamicResource AccentSoftBrush}"
                BorderThickness="1"
                Effect="{DynamicResource ShellShadow}"
                RenderTransformOrigin="0.92,1"
                IsHitTestVisible="True">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         From="18"
                                                         To="0"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Padding="8,4"
                                CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding SourceLabel}"
                                       FontSize="11"
                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding KindLabel}"
                                   Margin="8,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource ShellMutedBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Title}"
                               FontFamily="{DynamicResource ShellHeadingFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellForegroundBrush}" />
                    <TextBlock Text="{Binding Message}"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource ShellMutedBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="78" />
                    <Grid Margin="0,12,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding ProgressFraction, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="#14000000"
                                     BorderBrush="{DynamicResource ShellHairlineBrush}"
                                     BorderThickness="1" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="&#xE73E;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="{Binding ActionLabel}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="13,8"
                            Command="{Binding InvokeActionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAction}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Width="32"
                        Height="32"
                        Margin="14,0,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding DismissCommand}"
                        Content="&#xE711;" />
            </Grid>
        </Border>

        <Border DataContext="{Binding DesktopSwitchIndicator}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,44"
                Padding="18,10"
                CornerRadius="18"
                Background="#E016202A"
                BorderBrush="{DynamicResource AccentSoftBrush}"
                BorderThickness="1"
                Effect="{DynamicResource ShellShadow}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         From="0.92"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         From="0.92"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         From="14"
                                                         To="0"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Label}"
                       FontFamily="{DynamicResource ShellHeadingFont}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellForegroundBrush}" />
        </Border>
    </Grid>
</Window>
