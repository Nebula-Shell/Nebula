<UserControl x:Class="CaelestiaWin.UI.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CaelestiaWin.Core.Models;assembly=CaelestiaWin.Core"
             Visibility="Collapsed">
    <Grid x:Name="Backdrop"
          Margin="0,78,0,0"
          Background="Transparent"
          ClipToBounds="True"
          MouseLeftButtonDown="Backdrop_OnMouseLeftButtonDown">
        <Border x:Name="BackdropDimming"
                Background="#22101822"
                IsHitTestVisible="False"
                Opacity="0" />

        <Border x:Name="Panel"
                Width="440"
                HorizontalAlignment="Right"
                Margin="{Binding PanelMargin}"
                Padding="22"
                ClipToBounds="True"
                Opacity="0"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Style="{StaticResource GlassPanelStyle}"
                RenderTransformOrigin="1,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTranslate" X="36" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Notifications"
                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                   FontSize="26"
                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ShellButtonStyle}"
                            Command="{Binding ClearAllCommand}"
                            Padding="12,8"
                            Content="Clear all" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Notifications}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ClipToBounds="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotificationItem}">
                                <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,8,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Padding="8,4"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontFamily="{DynamicResource ShellHeadingFont}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Kind}"
                                                           Margin="8,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ShellMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{DynamicResource ShellHeadingFont}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                                            <TextBlock Text="{Binding Message}"
                                                       Margin="0,8,0,0"
                                                       Foreground="{DynamicResource ShellMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="6"
                                                             Minimum="0"
                                                             Maximum="1"
                                                             Value="{Binding NormalizedProgressFraction, Mode=OneWay}"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Background="#14000000"
                                                             BorderBrush="{DynamicResource ShellHairlineBrush}"
                                                             BorderThickness="1" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="&#xE73E;">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                       Margin="0,10,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ShellMutedBrush}" />
                                            <Button Content="{Binding PrimaryActionLabel}"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Left"
                                                    Padding="13,8"
                                                    Style="{StaticResource ShellButtonStyle}"
                                                    Command="{Binding DataContext.InvokeNotificationActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding PrimaryActionLabel, Converter={StaticResource StringHasTextToVisibilityConverter}}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="32"
                                                Height="32"
                                                Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE711;" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ShellMutedBrush}"
                               Text="You're all caught up.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNotifications}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="16"
                        Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding CalendarTitle}"
                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                   FontSize="17"
                                   Foreground="{DynamicResource ShellForegroundBrush}" />

                        <UniformGrid Columns="7"
                                     Margin="0,14,0,8">
                            <TextBlock Text="S" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                            <TextBlock Text="M" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                            <TextBlock Text="T" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                            <TextBlock Text="W" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                            <TextBlock Text="T" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                            <TextBlock Text="F" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                            <TextBlock Text="S" HorizontalAlignment="Center" Foreground="{DynamicResource ShellMutedBrush}" FontSize="11" />
                        </UniformGrid>

                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="38"
                                            Height="30"
                                            Margin="2"
                                            CornerRadius="15"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
                                                    <Setter Property="Opacity" Value="0.9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                            <Setter Property="Opacity" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF071018" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
