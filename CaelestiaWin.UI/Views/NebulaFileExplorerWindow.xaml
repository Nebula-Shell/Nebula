<Window x:Class="CaelestiaWin.UI.Views.NebulaFileExplorerWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Nebula Files"
        Width="1080"
        Height="760"
        MinWidth="720"
        MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ExplorerSidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SidebarButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="#142034" />
                                <Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SidebarButtonBorder" Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ExplorerTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerTabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ExplorerToolbarButtonStyle}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ExplorerListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ExplorerGridListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource LauncherListBoxStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>

        <Style x:Key="ExplorerGridListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding FullPath}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F0181D26" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="{DynamicResource ShellBodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MenuItemIcon"
                                           Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Icon}" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <TextBlock x:Name="CheckedIndicator"
                                           Grid.Column="2"
                                           Margin="12,0,2,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE73E;"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#14223C" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="MenuItemIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Margin="10,6"
                                Height="1"
                                Background="{DynamicResource ShellHairlineBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerQuickActionHostStyle" TargetType="MenuItem" BasedOn="{StaticResource ExplorerMenuItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="StaysOpenOnClick" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent"
                                Padding="2">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerQuickActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuickActionBorder"
                                Background="#0AFFFFFF"
                                BorderBrush="{DynamicResource ShellHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QuickActionBorder" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="QuickActionBorder" Property="Background" Value="#182034" />
                                <Setter TargetName="QuickActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ShellForegroundBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder"
                                Background="Transparent"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerGridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
            <Setter Property="Background" Value="#12000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="{DynamicResource ShellBodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,10,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#0BFFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding FullPath}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#162034" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            Margin="10"
            Style="{StaticResource GlassPanelStyle}"
            CornerRadius="24"
            Effect="{StaticResource ShellShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16,16,10,16"
                    Background="#0D0E1620"
                    BorderBrush="{DynamicResource ShellHairlineBrush}"
                    BorderThickness="0,0,1,0"
                    AllowDrop="True"
                    DragOver="SidebarPanel_OnDragOver"
                    Drop="SidebarPanel_OnDrop"
                    DragLeave="SidebarPanel_OnDragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="SidebarScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SidebarLocations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                    <Grid>
                                        <Border x:Name="SeparatorPanel"
                                                Margin="4,12,8,10"
                                                Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SectionTitle}"
                                                       Foreground="{DynamicResource ShellMutedBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Height="1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ShellHairlineBrush}" />
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="LocationContainer">
                                        <Border x:Name="DropBeforeIndicator"
                                                Margin="8,0,12,3"
                                                Height="3"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="1"
                                                Visibility="Collapsed" />
                                        <Button x:Name="LocationButton"
                                                Style="{StaticResource ExplorerSidebarButtonStyle}"
                                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Path}"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="SidebarLocationButton_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseDown="SidebarLocationButton_OnPreviewMouseDown"
                                                PreviewMouseMove="SidebarLocationButton_OnPreviewMouseMove"
                                                DragOver="SidebarLocationButton_OnDragOver"
                                                Drop="SidebarLocationButton_OnDrop"
                                                ContextMenuOpening="SidebarLocationButton_OnContextMenuOpening">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="DropInsideIndicator"
                                                        Grid.ColumnSpan="2"
                                                        Margin="-1"
                                                        CornerRadius="12"
                                                        Background="#142034"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1.5"
                                                        Visibility="Collapsed" />

                                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                    <Image x:Name="SidebarIconImage"
                                                           Width="18"
                                                           Height="18"
                                                           Source="{Binding IconSource}"
                                                           Stretch="Uniform"
                                                           Visibility="Collapsed" />
                                                    <TextBlock x:Name="SidebarGlyph"
                                                               Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>

                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ShellForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                        <Border x:Name="DropAfterIndicator"
                                                Margin="8,3,12,0"
                                                Height="3"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="1"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowGlyphFallback}" Value="False">
                                        <Setter TargetName="SidebarIconImage" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="SidebarGlyph" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowDropBefore}" Value="True">
                                        <Setter TargetName="DropBeforeIndicator" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowDropAfter}" Value="True">
                                        <Setter TargetName="DropAfterIndicator" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowDropInside}" Value="True">
                                        <Setter TargetName="DropInsideIndicator" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter TargetName="SeparatorPanel" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="LocationContainer" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border x:Name="SidebarDropHint"
                            Grid.Row="1"
                            Margin="0,10,8,0"
                            Padding="10,8"
                            CornerRadius="12"
                            Background="#14223C"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock Text="Drop folders here to pin them"
                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                   FontSize="11"
                                   TextAlignment="Center" />
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,12,8,0"
                            Padding="10"
                            CornerRadius="14"
                            Background="#09000000"
                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasAnyFileOperations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ActiveFileOperationIndicatorGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <ProgressBar Grid.Column="1"
                                         Margin="10,0,0,0"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding PrimaryFileOperationTask.ProgressFraction, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="#14000000"
                                         BorderBrush="{DynamicResource ShellHairlineBrush}"
                                         BorderThickness="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,0">
                                        <Border x:Name="TabWell"
                                                Margin="0,2,0,0"
                                                Background="#0E060B12"
                                                BorderBrush="#1EFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="16" />
                                        <Border x:Name="TabGlow"
                                                Margin="2,0,2,4"
                                                Background="#14FFFFFF"
                                                BorderBrush="#18FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="15"
                                                Opacity="0" />
                                        <Border x:Name="TabChrome"
                                                Margin="0,1,0,0"
                                                Background="#1011161E"
                                                BorderBrush="{DynamicResource ShellHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <Grid>
                                                <Border x:Name="TabInsetTop"
                                                        Margin="1,1,1,0"
                                                        VerticalAlignment="Top"
                                                        Height="10"
                                                        CornerRadius="13,13,7,7"
                                                        Background="#10FFFFFF" />
                                                <Border x:Name="TabInsetBottom"
                                                        Margin="1,0,1,1"
                                                        VerticalAlignment="Bottom"
                                                        Height="12"
                                                        CornerRadius="7,7,13,13"
                                                        Background="#18000000" />
                                                <Border x:Name="TabActiveIndicator"
                                                        Margin="10,0,10,0"
                                                        Height="2"
                                                        VerticalAlignment="Bottom"
                                                        CornerRadius="1"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Opacity="0" />
                                                <Button Background="Transparent"
                                                        Style="{StaticResource ExplorerTabButtonStyle}"
                                                        BorderThickness="0"
                                                        Padding="12,8,34,8"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Title}"
                                                               MaxWidth="180"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource ShellBodyFont}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ShellForegroundBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ExplorerTabCloseButtonStyle}"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE711;"
                                                ToolTip="Close tab" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabWell" Property="Opacity" Value="0" />
                                            <Setter TargetName="TabGlow" Property="Opacity" Value="1" />
                                            <Setter TargetName="TabChrome" Property="Margin" Value="0,0,0,2" />
                                            <Setter TargetName="TabChrome" Property="Background" Value="#18203346" />
                                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="TabInsetTop" Property="Background" Value="#18FFFFFF" />
                                            <Setter TargetName="TabInsetBottom" Property="Background" Value="#08000000" />
                                            <Setter TargetName="TabActiveIndicator" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="1"
                            Style="{StaticResource ExplorerToolbarButtonStyle}"
                            Margin="2,0,0,0"
                            Command="{Binding NewTabCommand}"
                            Content="&#xE710;"
                            ToolTip="New tab" />

                    <Button Grid.Column="2"
                            Style="{StaticResource ExplorerToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding CloseCommand}"
                            Content="&#xE711;"
                            ToolTip="Close" />
                </Grid>

                <Grid Grid.Row="1" MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                                Command="{Binding BackCommand}"
                                Content="&#xE72B;"
                                ToolTip="Back" />
                        <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                                Command="{Binding ForwardCommand}"
                                Content="&#xE72A;"
                                ToolTip="Forward" />
                        <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                                Command="{Binding UpCommand}"
                                Content="&#xE74A;"
                                ToolTip="Up" />
                        <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="&#xE72C;"
                                ToolTip="Refresh" />
                        <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                                Command="{Binding NewFolderCommand}"
                                Content="&#xE710;"
                                ToolTip="New folder" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="14,0,14,0"
                            Padding="12,8"
                            Background="#10000000"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  MouseLeftButtonDown="PathChrome_OnMouseLeftButtonDown">
                                <TextBlock IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource ShellBodyFont}"
                                           FontSize="15"
                                           Visibility="{Binding IsInlineSuggestionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding InlineSuggestionPrefix, Mode=OneWay}" Foreground="Transparent" />
                                        <Run Text="{Binding InlineSuggestionSuffix, Mode=OneWay}" Foreground="{DynamicResource ShellMutedBrush}" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding BreadcrumbSegments}"
                                              Visibility="{Binding IsBreadcrumbMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PathSegmentButtonStyle}"
                                                        Click="PathSegmentButton_OnClick"
                                                        Tag="{Binding}"
                                                        ToolTip="{Binding FullPath}">
                                                    <TextBlock x:Name="PathSegmentText"
                                                               Text="{Binding DisplayName}"
                                                               FontFamily="{DynamicResource ShellBodyFont}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource ShellForegroundBrush}" />
                                                </Button>
                                                <TextBlock Margin="2,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ShellMutedBrush}"
                                                           Text="›"
                                                           Visibility="{Binding ShowSeparator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="PathSegmentText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox x:Name="PathTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource ShellForegroundBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         SelectionBrush="{DynamicResource AccentSoftBrush}"
                                         FontFamily="{DynamicResource ShellBodyFont}"
                                         FontSize="15"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="PathTextBox_OnKeyDown"
                                         PreviewTextInput="PathTextBox_OnPreviewTextInput"
                                         PreviewKeyDown="PathTextBox_OnPreviewKeyDown"
                                         LostKeyboardFocus="PathTextBox_OnLostKeyboardFocus"
                                         Visibility="{Binding IsPathEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Border Width="200"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Padding="12,0"
                                        Background="#0CFFFFFF"
                                        BorderBrush="{DynamicResource ShellHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource ShellForegroundBrush}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 FontFamily="{DynamicResource ShellBodyFont}"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ShellMutedBrush}"
                                                   Text="&#xE721;" />
                                    </Grid>
                                </Border>

                                <Button x:Name="ViewMenuButton"
                                        Style="{StaticResource ExplorerToolbarButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="ViewMenuButton_OnClick"
                                        Content="&#xECA5;"
                                        ToolTip="View options" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource ExplorerToolbarButtonStyle}"
                                        Margin="0"
                                        Command="{Binding NavigateToInputPathCommand}"
                                        Content="&#xE72A;"
                                        ToolTip="Open path" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="4,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource ShellMutedBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="{Binding ItemCountText}"
                               Foreground="{DynamicResource ShellMutedBrush}" />
                </Grid>

                <Border Grid.Row="3"
                        Background="#09000000"
                        BorderBrush="{DynamicResource ShellHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10,10,10,6">
                    <Grid>
                        <ListView x:Name="FileListView"
                                  Style="{StaticResource ExplorerListViewStyle}"
                                  ItemContainerStyle="{StaticResource ExplorerListViewItemStyle}"
                                  ItemsSource="{Binding Items}"
                                  AllowDrop="True"
                                  PreviewMouseDown="FileListView_OnPreviewMouseDown"
                                  PreviewMouseLeftButtonDown="FileListView_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FileListView_OnPreviewMouseMove"
                                  PreviewMouseRightButtonDown="FileListView_OnPreviewMouseRightButtonDown"
                                  DragOver="FileListView_OnDragOver"
                                  Drop="FileListView_OnDrop"
                                  ContextMenuOpening="FileListView_OnContextMenuOpening"
                                  MouseDoubleClick="FileListView_OnMouseDoubleClick"
                                  Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ExplorerGridHeaderStyle}" />
                            </ListView.Resources>
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="Name" Width="380">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="ListItemGrid">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                                                        <Image x:Name="ItemIconImage"
                                                               Width="22"
                                                               Height="22"
                                                               Source="{Binding IconSource}"
                                                               Stretch="Uniform"
                                                               Visibility="Collapsed" />
                                                        <TextBlock x:Name="ItemGlyph"
                                                                   Text="{Binding Glyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="18"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Grid>

                                                    <Grid Grid.Column="1"
                                                          Margin="10,0,0,0"
                                                          VerticalAlignment="Center">
                                                        <TextBlock x:Name="ItemName"
                                                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                                                   Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="Visible" />
                                                        <TextBox x:Name="RenameBox"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="{DynamicResource ShellForegroundBrush}"
                                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                                 FontFamily="{DynamicResource ShellBodyFont}"
                                                                 FontSize="12"
                                                                 Padding="2,0"
                                                                 Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="Collapsed"
                                                                 KeyDown="RenameTextBox_OnKeyDown" />
                                                    </Grid>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ShowGlyphFallback}" Value="False">
                                                        <Setter TargetName="ItemIconImage" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="ItemGlyph" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                        <Setter TargetName="ItemIconImage" Property="Opacity" Value="0.5" />
                                                        <Setter TargetName="ItemGlyph" Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter TargetName="ItemName" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter TargetName="ListItemGrid" Property="Background" Value="#1E00B4F2" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding TypeLabel}" />
                                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeLabel}" />
                                    <GridViewColumn Header="Modified" Width="170" DisplayMemberBinding="{Binding ModifiedLabel}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <ListBox x:Name="FileGridView"
                                 Style="{StaticResource ExplorerGridListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ExplorerGridListBoxItemStyle}"
                                 ItemsSource="{Binding Items}"
                                 AllowDrop="True"
                                 PreviewMouseDown="FileGridView_OnPreviewMouseDown"
                                 PreviewMouseLeftButtonDown="FileGridView_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="FileGridView_OnPreviewMouseMove"
                                 PreviewMouseRightButtonDown="FileGridView_OnPreviewMouseRightButtonDown"
                                 DragOver="FileGridView_OnDragOver"
                                 Drop="FileGridView_OnDrop"
                                 ContextMenuOpening="FileGridView_OnContextMenuOpening"
                                 MouseDoubleClick="FileGridView_OnMouseDoubleClick"
                                 Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="GridCard"
                                            Width="{Binding DataContext.GridCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="{Binding DataContext.GridCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Background="#0BFFFFFF"
                                            BorderBrush="{DynamicResource ShellHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="10"
                                            ToolTip="{Binding FullPath}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="52" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Background="#08000000"
                                                    CornerRadius="12"
                                                    Padding="8">
                                                <Grid>
                                                    <Image x:Name="GridItemImage"
                                                           Width="{Binding DataContext.GridCardPreviewSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Height="{Binding DataContext.GridCardPreviewSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Source="{Binding IconSource}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                                    <TextBlock x:Name="GridItemGlyph"
                                                               Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="{Binding DataContext.GridCardIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource ShellForegroundBrush}"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="28" />

                                            <TextBox x:Name="GridRenameBox"
                                                     Grid.Row="1"
                                                     Margin="2,8,2,0"
                                                     Padding="4,2"
                                                     Background="Transparent"
                                                     BorderBrush="{DynamicResource ShellHairlineBrush}"
                                                     BorderThickness="1"
                                                     Foreground="{DynamicResource ShellForegroundBrush}"
                                                     CaretBrush="{DynamicResource AccentBrush}"
                                                     FontFamily="{DynamicResource ShellBodyFont}"
                                                     FontSize="11"
                                                     TextAlignment="Center"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="False"
                                                     Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="Collapsed"
                                                     KeyDown="RenameTextBox_OnKeyDown" />

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,4,0,0"
                                                       Text="{Binding TypeLabel}"
                                                       Foreground="{DynamicResource ShellMutedBrush}"
                                                       FontSize="9"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowGlyphFallback}" Value="False">
                                            <Setter TargetName="GridItemImage" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="GridItemGlyph" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                            <Setter TargetName="GridCard" Property="Background" Value="#12FFFFFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="GridCard" Property="Background" Value="#162034" />
                                            <Setter TargetName="GridCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                                            <Setter TargetName="GridItemImage" Property="Opacity" Value="0.5" />
                                            <Setter TargetName="GridItemGlyph" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter TargetName="GridRenameBox" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="GridCard" Property="Background" Value="#1E00B4F2" />
                                            <Setter TargetName="GridCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid IsHitTestVisible="False"
                              Visibility="{Binding IsLoadingEmptyList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Height="34"
                                    Margin="0,0,0,12"
                                    CornerRadius="12"
                                    Background="#12FFFFFF" />

                            <StackPanel Grid.Row="1">
                                <Border Height="54" Margin="0,0,0,8" CornerRadius="14" Background="#12FFFFFF">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" VerticalAlignment="Center" CornerRadius="11" Background="#18FFFFFF" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border Width="170" Height="10" CornerRadius="5" Background="#18FFFFFF" />
                                            <Border Width="110" Height="8" Margin="0,10,0,0" CornerRadius="4" Background="#10FFFFFF" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Height="54" Margin="0,0,0,8" CornerRadius="14" Background="#10FFFFFF">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" VerticalAlignment="Center" CornerRadius="11" Background="#16FFFFFF" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border Width="148" Height="10" CornerRadius="5" Background="#16FFFFFF" />
                                            <Border Width="96" Height="8" Margin="0,10,0,0" CornerRadius="4" Background="#0EFFFFFF" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Height="54" Margin="0,0,0,8" CornerRadius="14" Background="#0EFFFFFF">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" VerticalAlignment="Center" CornerRadius="11" Background="#14FFFFFF" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border Width="182" Height="10" CornerRadius="5" Background="#14FFFFFF" />
                                            <Border Width="120" Height="8" Margin="0,10,0,0" CornerRadius="4" Background="#0CFFFFFF" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <WrapPanel IsHitTestVisible="False"
                                  Visibility="{Binding IsLoadingEmptyGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Width="176" Height="184" Margin="0,0,12,12" CornerRadius="18" Background="#12FFFFFF" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#10000000" CornerRadius="14">
                                        <Border Width="76" Height="76" CornerRadius="18" Background="#18FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="1" Margin="8,14,8,0" Height="10" CornerRadius="5" Background="#18FFFFFF" />
                                    <Border Grid.Row="2" Margin="22,10,22,0" Height="8" CornerRadius="4" Background="#10FFFFFF" />
                                </Grid>
                            </Border>
                            <Border Width="176" Height="184" Margin="0,0,12,12" CornerRadius="18" Background="#10FFFFFF" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#0E000000" CornerRadius="14">
                                        <Border Width="76" Height="76" CornerRadius="18" Background="#16FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="1" Margin="16,14,16,0" Height="10" CornerRadius="5" Background="#16FFFFFF" />
                                    <Border Grid.Row="2" Margin="28,10,28,0" Height="8" CornerRadius="4" Background="#0EFFFFFF" />
                                </Grid>
                            </Border>
                            <Border Width="176" Height="184" Margin="0,0,12,12" CornerRadius="18" Background="#0EFFFFFF" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#0C000000" CornerRadius="14">
                                        <Border Width="76" Height="76" CornerRadius="18" Background="#14FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="1" Margin="10,14,10,0" Height="10" CornerRadius="5" Background="#14FFFFFF" />
                                    <Border Grid.Row="2" Margin="34,10,34,0" Height="8" CornerRadius="4" Background="#0CFFFFFF" />
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
