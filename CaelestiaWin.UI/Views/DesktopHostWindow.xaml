<Window x:Class="CaelestiaWin.UI.Views.DesktopHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Shell"
        Width="1600"
        Height="900"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ShellBackgroundBrush}"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="False">
    <Grid>
        <Grid>
            <Image x:Name="WallpaperImage"
                   Stretch="UniformToFill"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Rectangle Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0.62" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#66060C12" Offset="0" />
                        <GradientStop Color="#2A0A1018" Offset="0.28" />
                        <GradientStop Color="#7F03070D" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse x:Name="AccentDecoration"
                     Width="980"
                     Height="980"
                     Fill="{DynamicResource AccentSoftBrush}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-300,-260,0" />
            <Ellipse x:Name="SecondaryDecoration"
                     Width="720"
                     Height="720"
                     Fill="#143D648F"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-180,0,0,-240" />
        </Grid>

    </Grid>
</Window>
