<Window x:Class="CaelestiaWin.UI.Views.ScreenSnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Snip"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_OnKeyDown"
        Loaded="Window_OnLoaded"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        MouseMove="Window_OnMouseMove"
        MouseLeftButtonUp="Window_OnMouseLeftButtonUp">
    <Grid x:Name="Root"
          Background="#77000000"
          Cursor="Cross">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,32,0,0"
                Padding="18,10"
                CornerRadius="18"
                Background="#E8131B24"
                BorderBrush="{DynamicResource AccentSoftBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Select a region"
                           FontFamily="{DynamicResource ShellHeadingFont}"
                           FontSize="15"
                           Foreground="{DynamicResource ShellForegroundBrush}" />
                <TextBlock Text="  Esc to cancel"
                           FontSize="13"
                           Foreground="{DynamicResource ShellMutedBrush}" />
            </StackPanel>
        </Border>

        <Canvas x:Name="SelectionCanvas"
                IsHitTestVisible="False">
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    Background="#2279E6F5"
                    CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      Color="#8079E6F5"
                                      ShadowDepth="0"
                                      Opacity="0.72" />
                </Border.Effect>
            </Border>
        </Canvas>
    </Grid>
</Window>
