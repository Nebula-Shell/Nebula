<UserControl x:Class="CaelestiaWin.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CaelestiaWin.Core.Models;assembly=CaelestiaWin.Core"
             Visibility="Collapsed"
             Opacity="0">
    <Grid x:Name="Backdrop" Background="#8C081018" MouseLeftButtonDown="Backdrop_OnMouseLeftButtonDown">
        <Border Width="1180"
                MaxWidth="1180"
                MaxHeight="760"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource GlassPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Overview"
                               FontFamily="{DynamicResource ShellHeadingFont}"
                               FontSize="28"
                               Foreground="{DynamicResource ShellForegroundBrush}" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding CloseCommand}"
                            Content="&#xE711;" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OverviewWindowItem}">
                                <Button Style="{StaticResource TileButtonStyle}"
                                        Margin="0,0,16,16"
                                        Command="{Binding DataContext.ActivateWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Height="108"
                                                Background="#14000000"
                                                BorderBrush="{DynamicResource ShellHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18" />
                                        <TextBlock Margin="0,16,0,0"
                                                   Text="{Binding Title}"
                                                   FontFamily="{DynamicResource ShellHeadingFont}"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource ShellForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource ShellMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
