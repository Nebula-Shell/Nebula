<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="ShellAccentColor">#FF79E6F5</Color>
    <Color x:Key="ShellForegroundColor">#FFF5FBFF</Color>
    <Color x:Key="ShellMutedForegroundColor">#FF8FA7B7</Color>
    <Color x:Key="ShellHairlineColor">#22FFFFFF</Color>
    <Color x:Key="ShellSubtleColor">#0EFFFFFF</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ShellAccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2079E6F5" />
    <SolidColorBrush x:Key="ShellActiveIndicatorBrush" Color="#FFEAFEFF" />
    <SolidColorBrush x:Key="ShellDesktopIndicatorBrush" Color="#FFF3FBFF" />
    <LinearGradientBrush x:Key="ShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF091119" Offset="0" />
        <GradientStop Color="#FF050A10" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellPanelBrush" Color="#C2141B23" />
    <SolidColorBrush x:Key="ShellPanelAltBrush" Color="#D21B2430" />
    <SolidColorBrush x:Key="ShellForegroundBrush" Color="{DynamicResource ShellForegroundColor}" />
    <SolidColorBrush x:Key="ShellMutedBrush" Color="{DynamicResource ShellMutedForegroundColor}" />
    <SolidColorBrush x:Key="ShellHairlineBrush" Color="{DynamicResource ShellHairlineColor}" />
    <SolidColorBrush x:Key="ShellSubtleBrush" Color="{DynamicResource ShellSubtleColor}" />
    <SolidColorBrush x:Key="ShellBackdropBrush" Color="#88101822" />

    <CornerRadius x:Key="ShellCornerRadius">22</CornerRadius>
    <sys:Double x:Key="AnimationFastMs">140</sys:Double>
    <sys:Double x:Key="AnimationNormalMs">220</sys:Double>
    <sys:Double x:Key="AnimationSlowMs">320</sys:Double>
</ResourceDictionary>
